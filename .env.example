# Lumvika, self-hosted. Copy to `.env`, fill the lines marked REQUIRED, then run
#   node scripts/self-host-check.mjs
# which generates the secrets left empty and checks the rest before the first start.

# ---- The address people open in their browser -------------------------------------------------
# REQUIRED. Where the app is reached, without a trailing slash. Sign-in emails and provider
# sign-ins come back there.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# The port docker compose publishes the app on, on this machine.
LUMVIKA_APP_PORT=3000

# ---- Source code (AGPL-3.0, section 13) ----------------------------------------------------------
# The repository the Source link of the app points at. Change it when you run modified code.
NEXT_PUBLIC_SOURCE_REPO_URL=https://github.com/schnebel-technologie/lumvika
# Where the documentation is hosted. The Docs link and the in-app guide's search read it.
NEXT_PUBLIC_DOCS_URL=https://docs.lumvika.com

# ---- Postgres --------------------------------------------------------------------------------------
# The password of the Postgres docker compose runs. Generated by self-host-check.mjs.
POSTGRES_PASSWORD=
# Optional. A Postgres of your own instead (17 with the pgvector extension), e.g.
# postgres://user:password@db.example.com:5432/lumvika. Empty: the one above.
DATABASE_URL=

# ---- Sign-in -------------------------------------------------------------------------------------
# Signs the sessions. Generated by self-host-check.mjs; changing it signs everyone out.
BETTER_AUTH_SECRET=
# Optional sign-in with Google and Apple, next to the email code. Each needs its id and secret; the
# redirect URL to register with the provider is <NEXT_PUBLIC_APP_URL>/api/auth/callback/<google|apple>.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# The bundle id of your iOS build, for Sign in with Apple from the app.
APPLE_APP_BUNDLE_IDENTIFIER=
# Comma-separated providers the sign-in page offers (google, apple), among those configured above.
NEXT_PUBLIC_OAUTH_PROVIDERS=
# Cloudflare Turnstile on sign-up. Set both or neither: a secret without the site key refuses every sign-up.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# hCaptcha puzzle, shown to a visitor Turnstile could not vouch for (or to everyone without Turnstile).
# Set both or neither, like Turnstile's.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# ---- Email ---------------------------------------------------------------------------------------
# REQUIRED, one of the two: people sign in with a code sent by email.
# A Resend key (https://resend.com/api-keys). Until RESEND_FROM is on a domain verified there, Resend
# only delivers to the address of your Resend account.
RESEND_API_KEY=
# Or any SMTP server, e.g. smtps://user:password@smtp.example.com:465. Used when RESEND_API_KEY is empty.
SMTP_URL=
# The sender of every email, and where replies go. Uncomment to set them.
# RESEND_FROM=Lumvika <hello@your-domain.com>
# RESEND_MARKETING_FROM=Lumvika <news@your-domain.com>
# RESEND_REPLY_TO=support@your-domain.com

# ---- File storage --------------------------------------------------------------------------------
# The S3 store docker compose runs. Its secret key is generated by self-host-check.mjs.
S3_ACCESS_KEY_ID=lumvika
S3_SECRET_ACCESS_KEY=
# The port docker compose publishes it on, and the address a browser loads images from (the public
# buckets). Behind a domain, put its https address here.
LUMVIKA_STORAGE_PORT=3002
NEXT_PUBLIC_STORAGE_URL=http://localhost:3002
# Optional. Any other S3-compatible store instead (R2, AWS, MinIO): its endpoint, its region, and a
# prefix for the bucket names when the account is shared.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET_PREFIX=

# ---- The engine of your first workspace ---------------------------------------------------------
# Shared by the app and the engine started next to it. Generated by self-host-check.mjs.
LUMVIKA_ENGINE_API_KEY=
# The port docker compose publishes that engine on, and the address a browser reaches it at, to
# watch a coworker's screen. Behind a domain, put its https address here.
LUMVIKA_ENGINE_PORT=3001
LUMVIKA_ENGINE_BROWSER_URL=http://localhost:3001

# ---- AI ----------------------------------------------------------------------------------------
# The onboarding guide and a few helpers (company research, naming, ideas) run on OpenRouter.
# Your coworkers use whatever you connect in the app instead: an Anthropic, OpenAI, Gemini or
# OpenRouter key, or your Claude or ChatGPT subscription. https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional. Semantic search of the services catalog (keyword search works without it).
LUMVIKA_EMBED_API_KEY=

# ---- Admins ------------------------------------------------------------------------------------
# Comma-separated emails that see the admin switches in the app.
ADMIN_EMAILS=

# ---- Secrets, generated by self-host-check.mjs ---------------------------------------------------
# Signs the token the onboarding guide calls the app with.
STEWARD_HUB_TOKEN_SECRET=
STEWARD_HUB_TOKEN_REQUIRED=1
# Signs the board images the app captures for sharing.
BOARD_IMAGE_SECRET=
# Signs the unsubscribe links of the emails.
UNSUBSCRIBE_SECRET=
# Signs the access to the sites and files your coworkers publish.
PUBLISHED_ACCESS_SECRET=
# Signs the hand-off of a provider sign-in back to the iOS app.
MOBILE_OAUTH_TICKET_SECRET=

# ---- Optional services ---------------------------------------------------------------------------
# Composio connects 2,000+ apps by OAuth (https://composio.dev). Without it those connectors are off.
COMPOSIO_API_KEY=
# Web search for the coworkers (https://brave.com/search/api).
BRAVE_SEARCH_API_KEY=
# Reading websites (https://firecrawl.dev).
FIRECRAWL_API_KEY=
# LinkedIn and Google Maps research during onboarding (https://apify.com).
APIFY_TOKEN=
# Product analytics, off when empty (https://posthog.com).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
