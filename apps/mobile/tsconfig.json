{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@rerun/cloud-mobile/*": [
        "../../cloud/apps/mobile/src/*",
        "./src/cloud-oss/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    },
    "types": [
      "jest"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
